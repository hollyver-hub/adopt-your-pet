                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pet_id\": 1,\n  \"nome_completo\": \"Ana Clara Santos\",\n  \"whatsapp\": \"(82) 99876-5432\",\n  \"rotina\": \"Moro em casa murada e segura, trabalho em regime home office e tenho disponibilidade para passeios diários.\"\n}",
              "options": {
